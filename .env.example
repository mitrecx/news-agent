# 一次性模型导入（可选）
# 使用 scripts/import_model_from_env.py 导入指定账号；运行时仅使用页面中启用的模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Web Server Configuration
HOST=0.0.0.0
PORT=8000

# 一次性模型导入的生成参数
AGENT_MODEL=deepseek-chat
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2000

# Weibo Hot Search (微博热搜)
# 工具已集成，Agent 会自动判断何时调用
WEIBO_COOKIE=
WEIBO_SCRAPER_TIMEOUT=10
WEIBO_USE_SELENIUM=true  # 是否使用 Selenium 爬虫（需要安装 Chrome）

# Database Configuration (数据库配置)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=news_agent

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT 配置：保持稳定，同时用于个人模型密钥加密
JWT_SECRET=your-secret-key-change-this-in-production

# === Server Deployment Configuration (服务器部署配置) ===
# SSH Connection Information (SSH 连接信息)
SERVER_HOST=your-server-ip
SERVER_USER=your_username
SERVER_PORT=22

# Server Configuration (服务器配置)
SERVER_PROJECT_PATH=/home/your_username/news-agent
SERVER_DEPLOY_USER=nginx
