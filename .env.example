# ==========================================
# News Agent Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# ------------------------------------------
# DeepSeek API Configuration (必填)
# ------------------------------------------
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ------------------------------------------
# Web Server Configuration
# ------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------
# Agent Configuration
# ------------------------------------------
AGENT_MODEL=deepseek-chat
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2000

# ------------------------------------------
# Weibo Hot Search (微博热搜)
# ------------------------------------------
# 工具已集成，Agent 会自动判断何时调用
WEIBO_SCRAPER_TIMEOUT=10
WEIBO_USE_SELENIUM=true  # 是否使用 Selenium 爬虫（需要安装 Chrome）

# ------------------------------------------
# Database Configuration (数据库配置 - 必填)
# ------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=news_agent

# ------------------------------------------
# JWT Configuration (JWT 配置 - 生产环境必填)
# ------------------------------------------
# SECURITY WARNING: Always generate a strong random secret in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days (10080 minutes)

# ------------------------------------------
# Rate Limiting (速率限制)
# ------------------------------------------
# Requests per minute per IP address
RATE_LIMIT_PER_MINUTE=60
# Requests per hour per IP address
RATE_LIMIT_PER_HOUR=1000

# ------------------------------------------
# Security (安全配置)
# ------------------------------------------
# Enable/disable rate limiting
ENABLE_RATE_LIMIT=true
# Enable/disable security headers (recommended: true)
ENABLE_SECURITY_HEADERS=true

# ------------------------------------------
# Logging (日志配置)
# ------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: simple, detailed
LOG_FORMAT=detailed

# ------------------------------------------
# Database Pool (数据库连接池)
# ------------------------------------------
# Minimum number of connections in the pool
DB_POOL_MIN_SIZE=2
# Maximum number of connections in the pool
DB_POOL_MAX_SIZE=20
# Maximum time (in seconds) to wait for a connection
DB_POOL_TIMEOUT=30

# ------------------------------------------
# Cache Configuration (缓存配置)
# ------------------------------------------
# Weibo hot search cache TTL in seconds (default: 300 = 5 minutes)
WEIBO_CACHE_TTL=300

# ------------------------------------------
# Development/Production Flags
# ------------------------------------------
# Set to 'production' when deploying to production
ENVIRONMENT=development
# Enable debug mode (only for development!)
DEBUG=false
